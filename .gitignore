# CRLM dormancy project gitignore

# ----------------------------------------------------------------------
# macOS / editor / IDE files
# ----------------------------------------------------------------------
.DS_Store
.Spotlight-V100/
.Trashes/
.Rproj.user/
.vscode/.ropeproject/
.idea/

# ----------------------------------------------------------------------
# R / Python runtime files
# ----------------------------------------------------------------------
.Rhistory
.RData
.Ruserdata
renv/.cache/
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# ----------------------------------------------------------------------
# Logs, temporary files and LaTeX intermediates
# ----------------------------------------------------------------------
*.log
*.tmp
*.temp
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.lof
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.vrb

# ----------------------------------------------------------------------
# Large local omics files and local reference/cache resources
# ----------------------------------------------------------------------
*.fastq
*.fq
*.fastq.gz
*.fq.gz
*.bam
*.sam
*.cram
*.bai
*.crai
data/**

# ----------------------------------------------------------------------
# Generated Beamer TeX files
# ----------------------------------------------------------------------
# These TeX files are generated by scripts/beamer/build and should not be
# committed. Keep only the build scripts and reusable generator code in Git.
scripts/beamer/beamer_report.tex
scripts/beamer/sections/
scripts/beamer/generated_tables/

# ----------------------------------------------------------------------
# Analysis outputs and intermediate files
# ----------------------------------------------------------------------
# Keep results visible to Git so CSV/PDF/PNG summaries can be reviewed and
# synced. Note that .gitignore cannot filter files by size; large generated
# result objects must be ignored by path or file type.
!results/
!results/**

# Re-apply global housekeeping ignores inside results after the broad unignore
# above; otherwise results/** makes these files visible again.
results/.DS_Store
results/**/.DS_Store
results/*.log
results/**/*.log
results/*.tmp
results/**/*.tmp
results/*.temp
results/**/*.temp

# Large binary result artifacts and caches should not be committed. This keeps
# GitHub-safe result tables/figures visible while excluding common files that
# can easily exceed the 200 MB single-file limit.
results/**/*.rds
results/**/*.RData
results/**/*.rda
results/**/*.qs
results/**/*.qs2
results/**/*.h5
results/**/*.h5ad
results/**/*.loom
results/**/*.mtx
results/**/*.bam
results/**/*.sam
results/**/*.cram
results/**/*.fastq
results/**/*.fq
results/**/*.fastq.gz
results/**/*.fq.gz

temporary/**
omnipathr-log/
omipathr-log/
manuscripts/

# ----------------------------------------------------------------------
# Keep explicit placeholder files if they are ever needed for empty folders
# ----------------------------------------------------------------------
!**/.keep
